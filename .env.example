# 复制为 .env 并填写; .env 已被 git 忽略
# 首启引导 (推荐): 全留空直接 ./run.sh, 浏览器打开 /setup 注册第一个
# 管理员。AUTH_PASS 是旧口径的种子: 设了的话空账号库启动自动种
# admin, 不再进引导 (仓库是公开的, 不带默认口令; 种过之后走界面改)
AUTH_USER=admin
AUTH_PASS=

# 可选: 服务端口 (有证书时 PORT 走 HTTPS, HTTP_PORT 并行开明文;
# 没证书或 HTTP=1 ./run.sh 时只有一个明文进程, PORT 即最终口)
# PORT=8500
# HTTP_PORT=8501

# 可选: 记账库 SQLite (默认 data/bookkeeping.db; 要写完整 URL,
# 引擎在 app/bookkeeping/store 里只认 URL 形式)
# MYTESLA_BOOKKEEPING_DB=sqlite:///data/bookkeeping.db

# 可选: 账号库与会话密钥 (My Home 组合部署时由外层指到共享文件,
# 独立部署默认在仓内; 裸路径相对仓根, 账号库也可写完整 sqlite:///… URL)
# MYHOME_USERS_DB=data/users.db
# MYHOME_SECRET_FILE=.session_secret
